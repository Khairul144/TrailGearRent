# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi kredensial asli.

DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=TrailGear_auth
DB_USER=tg_user
DB_PASSWORD=ganti-dengan-password-anda
DB_HOST=127.0.0.1
DB_PORT=5432

# Opsional — nilai di bawah adalah default di settings.py
# Aktifkan hanya saat aplikasi sudah berjalan di HTTPS:
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_AGE=43200
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_LOGIN_ATTEMPTS=5

# Account lockout (opsional, default di settings.py)
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_DURATION=15
